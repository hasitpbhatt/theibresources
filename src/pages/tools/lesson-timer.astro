---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout
  title="Lesson timer"
  description="A large visible countdown that runs through a sequence of timed lesson segments. Build the agenda once, save it on your device, and share it by link."
>
  <div class="shell page">
    <Breadcrumb
      items={[
        { href: '/', label: 'Home' },
        { href: '/tools', label: 'Teacher tools' },
        { label: 'Lesson timer' },
      ]}
    />

    <header class="page__head">
      <span class="eyebrow">Classroom tool</span>
      <h1>Lesson timer</h1>
      <p class="page__lede">
        A countdown big enough to read from the back row, plus the agenda behind it so nobody has to
        ask what comes next.
      </p>
    </header>

    <div class="app">
      <div class="clock" id="clock">
        <div class="clock__label" id="phaseLabel">Ready</div>
        <div class="clock__time" id="time" role="timer" aria-live="off">00:00</div>
        <div class="clock__next" id="nextLabel"></div>
        <div class="clock__bar" aria-hidden="true"><span id="bar"></span></div>
        <div class="clock__actions">
          <button class="btn" id="toggle" type="button">Start</button>
          <button class="btn btn--ghost" id="skip" type="button">Next segment</button>
          <button class="btn btn--ghost" id="reset" type="button">Reset</button>
        </div>
        <p class="clock__hint" id="clockHint" role="status" aria-live="polite"></p>
      </div>

      <div class="panel">
        <p class="panel__title">Agenda</p>
        <ol class="agenda" id="agenda"></ol>
        <div class="panel__actions">
          <button class="btn btn--ghost" id="addSeg" type="button">Add segment</button>
          <button class="btn btn--ghost" id="copyLink" type="button">Copy share link</button>
          <button class="btn btn--ghost" id="clear" type="button">Reset agenda</button>
        </div>
        <p class="hint" id="hint"></p>
      </div>
    </div>

    <section class="foot">
      <div class="note">
        <p>
          <strong>Why a bar and not a dial.</strong> A shrinking bar is readable at a glance from a
          distance and does not need a second hand. When a segment ends the timer stops rather than
          rolling into the next one, so you decide when to move on.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 2.4rem 0;
  }

  .page__head {
    max-width: 60ch;
    margin-bottom: 2.4rem;
  }

  .page__lede {
    font-size: 1.05rem;
    color: var(--ink-muted);
  }

  .app {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    gap: 1.6rem;
    align-items: start;
  }

  .clock {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    padding: 1.6rem 1.8rem 1.8rem;
    position: sticky;
    top: 5.5rem;
  }

  .clock__label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  .clock__time {
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 12vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    margin: 0.25em 0 0.15em;
  }

  .clock--over .clock__time {
    color: var(--accent);
  }

  .clock__next {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    min-height: 1.3em;
  }

  .clock__bar {
    height: 4px;
    background: var(--paper-sunk);
    border-radius: 999px;
    overflow: hidden;
    margin: 1.1rem 0 1.4rem;
  }

  .clock__bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: left center;
    transition: transform 0.25s linear;
  }

  .clock__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .clock__hint,
  .hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    min-height: 1.2em;
    margin: 0.8rem 0 0;
    word-break: break-all;
  }

  .panel {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    padding: 1.2rem 1.3rem;
  }

  .panel__title {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.9rem;
  }

  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .seg {
    display: grid;
    grid-template-columns: 1fr 4.2rem 1.6rem;
    gap: 0.4rem;
    align-items: center;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .seg--active {
    background: var(--accent-wash);
    margin-inline: -0.5rem;
    padding-inline: 0.5rem;
    border-radius: 2px;
  }

  .seg--done {
    opacity: 0.45;
  }

  .seg input {
    font-family: inherit;
    font-size: 0.88rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    width: 100%;
    padding: 0.2rem 0;
  }

  .seg input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .seg input[type='number'] {
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .seg__del {
    border: 0;
    background: transparent;
    color: var(--ink-faint);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0.2rem;
    border-radius: 2px;
  }

  .seg__del:hover {
    color: var(--accent);
  }

  .panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .foot {
    margin-top: 2.8rem;
    max-width: 70ch;
  }

  @media (max-width: 56rem) {
    .app {
      grid-template-columns: 1fr;
    }
    .clock {
      position: static;
    }
  }
</style>

<script>
  const STORE = 'fn.lessonTimer.v1';

  const toBase64 = (text: string) => {
    const bytes = new TextEncoder().encode(text);
    let binary = '';
    for (const byte of bytes) binary += String.fromCharCode(byte);
    return btoa(binary);
  };

  const fromBase64 = (hash: string) => {
    const binary = atob(hash);
    const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
    return new TextDecoder().decode(bytes);
  };

  type Segment = { name: string; minutes: number };

  const DEFAULTS: Segment[] = [
    { name: 'Starter', minutes: 5 },
    { name: 'Main activity', minutes: 20 },
    { name: 'Independent work', minutes: 15 },
    { name: 'Plenary', minutes: 5 },
  ];

  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  const agendaEl = $('agenda');
  const timeEl = $('time');
  const phaseEl = $('phaseLabel');
  const nextEl = $('nextLabel');
  const barEl = $('bar');
  const toggleEl = $('toggle') as HTMLButtonElement;
  const clockEl = $('clock');
  const clockHint = $('clockHint');
  const hintEl = $('hint');

  let segments: Segment[] = [];
  let index = 0;
  let remaining = 0;
  let total = 0;
  let running = false;
  let ticker: number | null = null;
  let last = 0;

  const fmt = (ms: number) => {
    const s = Math.max(0, Math.round(ms / 1000));
    return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
  };

  function load() {
    let data: Segment[] | null = null;

    const hash = location.hash.slice(1);
    if (hash) {
      try {
        data = JSON.parse(fromBase64(hash)) as Segment[];
      } catch {
        data = null;
      }
    }

    if (!data) {
      try {
        const raw = localStorage.getItem(STORE);
        if (raw) data = JSON.parse(raw) as Segment[];
      } catch {
        data = null;
      }
    }

    segments = Array.isArray(data) && data.length ? data : DEFAULTS.map((s) => ({ ...s }));
  }

  function save() {
    try {
      localStorage.setItem(STORE, JSON.stringify(segments));
    } catch {
      /* ignore */
    }
  }

  function drawAgenda() {
    agendaEl.innerHTML = '';
    segments.forEach((seg, i) => {
      const li = document.createElement('li');
      li.className =
        'seg' + (i === index ? ' seg--active' : '') + (i < index ? ' seg--done' : '');

      const name = document.createElement('input');
      name.type = 'text';
      name.value = seg.name;
      name.setAttribute('aria-label', `Segment ${i + 1} name`);
      name.addEventListener('input', () => {
        segments[i].name = name.value;
        save();
        if (i === index) phaseEl.textContent = name.value || 'Segment';
      });

      const mins = document.createElement('input');
      mins.type = 'number';
      mins.min = '1';
      mins.max = '180';
      mins.value = String(seg.minutes);
      mins.setAttribute('aria-label', `Segment ${i + 1} minutes`);
      mins.addEventListener('change', () => {
        const v = Math.min(Math.max(Number(mins.value) || 1, 1), 180);
        mins.value = String(v);
        segments[i].minutes = v;
        save();
        if (i === index) {
          remaining = v * 60000;
          total = remaining;
          render();
        }
      });

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'seg__del';
      del.textContent = '×';
      del.setAttribute('aria-label', `Remove segment ${i + 1}`);
      del.addEventListener('click', () => {
        if (segments.length === 1) return;
        segments.splice(i, 1);
        if (index >= segments.length) index = segments.length - 1;
        save();
        drawAgenda();
        selectSegment(index, false);
      });

      li.append(name, mins, del);
      agendaEl.append(li);
    });
  }

  function selectSegment(i: number, autostart: boolean) {
    stop();
    index = Math.min(Math.max(i, 0), segments.length - 1);
    total = segments[index].minutes * 60000;
    remaining = total;
    drawAgenda();
    render();
    if (autostart) start();
  }

  function render() {
    timeEl.textContent = fmt(remaining);
    phaseEl.textContent = segments[index]?.name || 'Ready';
    const nxt = segments[index + 1];
    nextEl.textContent = nxt ? `Next: ${nxt.name} · ${nxt.minutes} min` : 'Last segment';
    const ratio = total > 0 ? Math.max(0, Math.min(1, remaining / total)) : 0;
    barEl.style.transform = `scaleX(${ratio})`;
    clockEl.classList.toggle('clock--over', remaining <= 0);
    toggleEl.textContent = running ? 'Pause' : remaining <= 0 ? 'Restart' : 'Start';
  }

  function tick() {
    const now = performance.now();
    const delta = now - last;
    last = now;
    remaining -= delta;

    if (remaining <= 0) {
      remaining = 0;
      render();
      stop();
      clockHint.textContent = `${segments[index].name} finished.`;
      return;
    }

    render();
  }

  function start() {
    if (running) return;
    if (remaining <= 0) remaining = total;
    running = true;
    last = performance.now();
    ticker = window.setInterval(tick, 250);
    clockHint.textContent = '';
    render();
  }

  function stop() {
    running = false;
    if (ticker !== null) {
      clearInterval(ticker);
      ticker = null;
    }
    render();
  }

  toggleEl.addEventListener('click', () => (running ? stop() : start()));

  $('skip').addEventListener('click', () => {
    if (index < segments.length - 1) {
      selectSegment(index + 1, false);
      clockHint.textContent = 'Moved to the next segment.';
    } else {
      stop();
      clockHint.textContent = 'That was the last segment.';
    }
  });

  $('reset').addEventListener('click', () => selectSegment(0, false));

  $('addSeg').addEventListener('click', () => {
    segments.push({ name: 'New segment', minutes: 5 });
    save();
    drawAgenda();
  });

  $('copyLink').addEventListener('click', async () => {
    const payload = toBase64(JSON.stringify(segments));
    const url = `${location.origin}${location.pathname}#${payload}`;
    try {
      await navigator.clipboard.writeText(url);
      hintEl.textContent = 'Share link copied.';
    } catch {
      hintEl.textContent = url;
    }
  });

  $('clear').addEventListener('click', () => {
    try {
      localStorage.removeItem(STORE);
    } catch {
      /* ignore */
    }
    segments = DEFAULTS.map((s) => ({ ...s }));
    index = 0;
    save();
    drawAgenda();
    selectSegment(0, false);
    hintEl.textContent = 'Agenda reset to the default lesson shape.';
  });

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.code === 'Space') {
      e.preventDefault();
      running ? stop() : start();
    }
  });

  load();
  drawAgenda();
  selectSegment(0, false);
</script>
